# Configuration for Remote Status Monitor
# These settings control the status broadcaster service

# UDP broadcast port (must match MMM-RemoteTempMonitor)
STATUS_BROADCAST_PORT=9876

# HTTP diagnostics port; loopback-only by default.
STATUS_BROADCAST_HTTP_HOST=127.0.0.1
STATUS_BROADCAST_HTTP_PORT=9878

# HTTP diagnostics port (optional, separate from UDP broadcasts)
# Leave empty to disable HTTP endpoint
# STATUS_BROADCAST_HTTP_PORT=8080

# Shared secret for authenticated UDP packets (optional)
# STATUS_BROADCAST_SHARED_SECRET=your-secret-key

# Broadcast targets (comma-separated or use <broadcast> for all)
# Default: <broadcast>
# STATUS_BROADCAST_TARGETS=192.168.1.100,192.168.1.101

# How often to check for system updates (in seconds)
# Default: 600 (10 minutes)
STATUS_BROADCAST_CHECK_INTERVAL=600

# Optional repository to check for uncommitted changes
# STATUS_BROADCAST_REPO=/home/pi/desk_display

# Broadcast cached status every 60 seconds
STATUS_BROADCAST_INTERVAL=60
